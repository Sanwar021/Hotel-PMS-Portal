APP_ENV=development
PORT=8095

DB_HOST=localhost
DB_PORT=5435
DB_USER=hotelos
DB_PASSWORD=replace-me
DB_NAME=hotelos_db
DB_SSLMODE=disable

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=24h
CORS_ORIGIN=http://localhost:5173

# Development/demo only. Set false in production.
SEED_DEMO_DATA=true

# Required on a clean production database when SEED_DEMO_DATA=false.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
BOOTSTRAP_HOTEL_NAME=My Hotel
BOOTSTRAP_HOTEL_CODE=HOTEL-01
